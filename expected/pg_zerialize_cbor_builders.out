SET client_min_messages TO warning;
DROP EXTENSION IF EXISTS pg_zerialize CASCADE;
CREATE EXTENSION pg_zerialize;
-- Mirrors pg_zerialize_builders.sql / pg_zerialize_builders_semantics.sql for
-- the CBOR builder API (cbor_from_jsonb, cbor_build_object, cbor_build_array,
-- cbor_agg, cbor_object_agg), added alongside MessagePack's.
SELECT cbor_build_object('id', 1, 'name', 'alice', 'active', true) IS NOT NULL AS build_object_ok;
 build_object_ok 
-----------------
 t
(1 row)

SELECT cbor_build_array(1, 'x', true, NULL) IS NOT NULL AS build_array_ok;
 build_array_ok 
----------------
 t
(1 row)

-- Array/object semantics parity: builder vs jsonb conversion, within CBOR.
SELECT cbor_build_array(1, 'x', true, NULL, 42.5::numeric)
       = cbor_from_jsonb(jsonb_build_array(1, 'x', true, NULL, 42.5::numeric)) AS array_parity;
 array_parity 
--------------
 t
(1 row)

SELECT cbor_build_object('a', 1, 'b', 'x', 'c', true)
       = cbor_from_jsonb(jsonb_build_object('a', 1, 'b', 'x', 'c', true)) AS object_parity;
 object_parity 
---------------
 t
(1 row)

-- Nested semantics parity.
SELECT cbor_from_jsonb(
           jsonb_build_object(
               'a', jsonb_build_array(1,2,3),
               'b', jsonb_build_object('x', true, 'y', NULL),
               'c', jsonb_build_array(jsonb_build_object('k', 1), jsonb_build_object('k', 2))
           )
       )
       = cbor_from_jsonb(
           jsonb_build_object(
               'a', jsonb_build_array(1,2,3),
               'b', jsonb_build_object('x', true, 'y', NULL),
               'c', jsonb_build_array(jsonb_build_object('k', 1), jsonb_build_object('k', 2))
           )
       ) AS nested_stable;
 nested_stable 
---------------
 t
(1 row)

-- Cross-check against MessagePack's independently-tested builder, decoded
-- through each protocol's own JSONB decoder.
SELECT (cbor_to_jsonb(cbor_build_object('id', 7, 'active', true))
        = msgpack_to_jsonb(msgpack_build_object('id', 7, 'active', true))) AS matches_msgpack;
 matches_msgpack 
-----------------
 t
(1 row)

CREATE TABLE pgz_cbor_bld_emp(id int, dept int, name text, role text);
INSERT INTO pgz_cbor_bld_emp VALUES
    (1, 10, 'ann', 'dev'),
    (2, 10, 'bob', 'lead'),
    (3, 20, 'cam', 'ae');
SELECT cbor_agg(jsonb_build_object('id', id, 'name', name) ORDER BY id) IS NOT NULL AS agg_ok
FROM pgz_cbor_bld_emp;
 agg_ok 
--------
 t
(1 row)

SELECT cbor_agg(jsonb_build_object('id', id, 'name', name) ORDER BY id)
       = cbor_from_jsonb(jsonb_agg(jsonb_build_object('id', id, 'name', name) ORDER BY id)) AS agg_parity
FROM pgz_cbor_bld_emp;
 agg_parity 
------------
 t
(1 row)

SELECT cbor_object_agg(name, role ORDER BY name) IS NOT NULL AS object_agg_ok
FROM pgz_cbor_bld_emp;
 object_agg_ok 
---------------
 t
(1 row)

SELECT cbor_object_agg(name, role ORDER BY name)
       = cbor_from_jsonb(jsonb_object_agg(name, role ORDER BY name)) AS object_agg_parity
FROM pgz_cbor_bld_emp;
 object_agg_parity 
-------------------
 t
(1 row)

-- Join-shaped nested build, same pattern as the msgpack builder tests.
WITH nested_employees AS (
  SELECT
    dept,
    jsonb_agg(jsonb_build_object('id', id, 'name', name, 'role', role) ORDER BY id) AS staff
  FROM pgz_cbor_bld_emp
  GROUP BY dept
)
SELECT cbor_from_jsonb(
         jsonb_build_object(
           'dept_id', d.dept,
           'dept_name', d.dept_name,
           'staff', COALESCE(ne.staff, '[]'::jsonb)
         )
       ) IS NOT NULL AS join_nested_not_null
FROM (VALUES (10,'eng'), (20,'sales'), (30,'ops')) AS d(dept, dept_name)
LEFT JOIN nested_employees ne ON ne.dept = d.dept
ORDER BY d.dept;
 join_nested_not_null 
----------------------
 t
 t
 t
(3 rows)

-- Invalid input checks for builder-style APIs.
SELECT cbor_build_object('a', 1, 'b');
ERROR:  cbor_build_object requires an even number of arguments
SELECT cbor_build_object(NULL, 1);
ERROR:  cbor_build_object key must not be null
DROP TABLE pgz_cbor_bld_emp;
DROP EXTENSION pg_zerialize;
